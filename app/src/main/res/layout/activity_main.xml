<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <!-- Yüzen hap biçimli alt menü; detay ve sohbet ekranlarında aşağı kayarak gizlenir -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="16dp"
        android:outlineAmbientShadowColor="@color/electric_violet"
        android:outlineSpotShadowColor="@color/electric_violet"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.Blipwave.NavIndicator"
            app:itemIconTint="@color/nav_item"
            app:itemPaddingBottom="6dp"
            app:itemPaddingTop="6dp"
            app:itemTextAppearanceActive="@style/TextAppearance.Blipwave.NavLabel"
            app:itemTextColor="@color/bp_on_background"
            app:labelVisibilityMode="selected"
            app:menu="@menu/bottom_nav" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
