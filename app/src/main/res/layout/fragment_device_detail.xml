<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/bp_on_background"
        tools:title="Blipwave Echo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Bağlantı kartı -->
            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_card_hero"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="@color/electric_violet"
                android:outlineSpotShadowColor="@color/electric_violet"
                android:padding="24dp">

                <dev.blipwave.ui.components.ConnectionOrbView
                    android:id="@+id/orb"
                    android:layout_width="132dp"
                    android:layout_height="132dp" />

                <dev.blipwave.ui.components.StatusPillView
                    android:id="@+id/status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Blipwave.Mono"
                    tools:text="D0:0D:1E:00:00:01" />

                <TextView
                    android:id="@+id/reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Blipwave.Caption"
                    android:textColor="@color/bp_error"
                    android:visibility="gone"
                    tools:text="Reason: Timeout"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/disconnect_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/detail_disconnect"
                        app:icon="@drawable/ic_link_off" />

                    <TextView
                        android:id="@+id/reconnect_button"
                        style="@style/Widget.Blipwave.GradientButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_warm"
                        android:drawableStart="@drawable/ic_link"
                        android:text="@string/detail_reconnect"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/console_button"
                        style="@style/Widget.Blipwave.GradientButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_forum"
                        android:text="@string/detail_open_console" />
                </LinearLayout>

                <TextView
                    android:id="@+id/no_uart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/detail_no_uart"
                    android:textAppearance="@style/TextAppearance.Blipwave.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Canlı sinyal kartı (klasik SPP bağlantısında RSSI okunamadığı için gizlenir) -->
            <LinearLayout
                android:id="@+id/signal_card"
                style="@style/Widget.Blipwave.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_signal_title"
                            android:textAppearance="@style/TextAppearance.Blipwave.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_signal_caption"
                            android:textAppearance="@style/TextAppearance.Blipwave.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/latest_rssi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="-47 dBm" />

                    <dev.blipwave.ui.components.SignalBarsView
                        android:id="@+id/latest_bars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="14dp">

                    <dev.blipwave.ui.components.RssiChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/signal_waiting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/detail_signal_waiting"
                        android:textAppearance="@style/TextAppearance.Blipwave.Body" />
                </FrameLayout>
            </LinearLayout>

            <!-- Servisler -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_services_title"
                    android:textAppearance="@style/TextAppearance.Blipwave.Headline" />

                <TextView
                    android:id="@+id/services_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:text="5"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/services_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Blipwave.Body"
                tools:text="@string/detail_discovering" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/services_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/bp_tertiary"
                app:trackColor="@color/bp_surface_high"
                app:trackCornerRadius="4dp" />

            <LinearLayout
                android:id="@+id/services_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:animateLayoutChanges="true"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
