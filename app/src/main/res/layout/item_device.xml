<?xml version="1.0" encoding="utf-8"?>
<!-- Dış çerçeveyi RecyclerView'ın animatörü, içteki kartı giriş animasyonu oynatır;
     ikisi aynı görünümü canlandırırsa RecyclerView çöker -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="14dp">

<LinearLayout
    android:id="@+id/card"
    style="@style/Widget.Blipwave.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_clickable"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_cool">

            <ImageView
                android:id="@+id/avatar_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_bluetooth"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Blipwave.Title"
                tools:text="Blipwave Echo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Blipwave.Mono"
                    tools:text="D0:0D:1E:00:00:01" />

                <!-- Klasik / çift mod etiketi; BLE cihazlarda gizli -->
                <TextView
                    android:id="@+id/transport_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="Klasik"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <dev.blipwave.ui.components.SignalBarsView
                android:id="@+id/signal_bars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/rssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="-47 dBm" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/classic_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/classic_spp_hint"
            android:textAppearance="@style/TextAppearance.Blipwave.Caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/connect"
            style="@style/Widget.Blipwave.GradientButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_link"
            android:text="@string/device_connect" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
