<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <!-- Radar ve filtreler listeyle birlikte yukarı kayar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            app:layout_scrollFlags="scroll">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Blipwave.Display" />

                <TextView
                    android:id="@+id/demo_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/demo_badge"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_tagline"
                android:textAppearance="@style/TextAppearance.Blipwave.Body" />

            <!-- İzin açıklama kartı -->
            <LinearLayout
                android:id="@+id/permission_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_hero"
                android:elevation="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_warm">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/permission_title"
                    android:textAppearance="@style/TextAppearance.Blipwave.Headline" />

                <TextView
                    android:id="@+id/permission_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Blipwave.Body"
                    tools:text="@string/permission_body_s" />

                <TextView
                    android:id="@+id/permission_grant"
                    style="@style/Widget.Blipwave.GradientButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/permission_grant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permission_demo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_try_demo"
                    app:icon="@drawable/ic_science" />
            </LinearLayout>

            <!-- Radar kartı -->
            <LinearLayout
                android:id="@+id/radar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_hero"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="@color/electric_violet"
                android:outlineSpotShadowColor="@color/electric_violet"
                android:padding="20dp">

                <dev.blipwave.ui.components.PulseRadarView
                    android:id="@+id/radar"
                    android:layout_width="210dp"
                    android:layout_height="210dp" />

                <TextView
                    android:id="@+id/scan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/scan_status_idle"
                    android:textAppearance="@style/TextAppearance.Blipwave.Title" />

                <TextView
                    android:id="@+id/scan_toggle"
                    style="@style/Widget.Blipwave.GradientButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_play"
                    android:text="@string/scan_start" />
            </LinearLayout>

            <!-- Filtre çubuğu -->
            <LinearLayout
                android:id="@+id/filter_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scan_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Blipwave.Body"
                    android:textStyle="bold"
                    tools:text="3 of 5 devices" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_named"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/filter_named_only" />

                <ImageButton
                    android:id="@+id/filter_toggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/filter_toggle"
                    android:src="@drawable/ic_tune" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_panel"
                style="@style/Widget.Blipwave.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/min_signal_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Blipwave.Label"
                    android:textColor="@color/bp_on_background"
                    tools:text="Minimum signal: -100 dBm" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/min_signal_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="-100"
                    android:valueFrom="-100"
                    android:valueTo="-30"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:thumbColor="@color/bp_tertiary"
                    app:trackColorActive="@color/bp_primary"
                    app:trackColorInactive="@color/bp_surface_highest" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transport_label"
                    android:textAppearance="@style/TextAppearance.Blipwave.Label"
                    android:textColor="@color/bp_on_background" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/transport_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    app:checkedChip="@id/transport_all"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/transport_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/transport_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/transport_le"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/transport_le" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/transport_classic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/transport_classic" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_label"
                    android:textAppearance="@style/TextAppearance.Blipwave.Label"
                    android:textColor="@color/bp_on_background" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sort_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:checkedChip="@id/sort_signal"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sort_signal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_signal" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sort_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_name" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sort_recent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_recent" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Hata kartı -->
            <LinearLayout
                android:id="@+id/error_card"
                style="@style/Widget.Blipwave.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bluetooth_disabled"
                    app:tint="@color/bp_error" />

                <TextView
                    android:id="@+id/error_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Blipwave.Body"
                    android:textColor="@color/bp_on_background"
                    tools:text="@string/error_bluetooth_off" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/error_action"
                    style="@style/Widget.Blipwave.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/action_turn_on" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.Blipwave.Body"
                android:visibility="gone"
                tools:text="@string/scan_empty_body"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="110dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_device" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
