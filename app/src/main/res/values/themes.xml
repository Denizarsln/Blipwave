<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Blipwave" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bp_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/bp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/bp_on_primary_container</item>
        <item name="colorSecondary">@color/bp_secondary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorTertiary">@color/bp_tertiary</item>
        <item name="colorOnTertiary">@android:color/white</item>
        <item name="colorError">@color/bp_error</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="android:colorBackground">@color/bp_background</item>
        <item name="colorOnBackground">@color/bp_on_background</item>
        <item name="colorSurface">@color/bp_background</item>
        <item name="colorOnSurface">@color/bp_on_background</item>
        <item name="colorSurfaceVariant">@color/bp_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/bp_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/bp_surface</item>
        <item name="colorSurfaceContainerHigh">@color/bp_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/bp_surface_highest</item>
        <item name="colorOutline">@color/bp_outline</item>
        <item name="colorControlNormal">@color/bp_on_surface_variant</item>

        <item name="android:windowBackground">@color/bp_background</item>
        <item name="android:statusBarColor">@color/bp_background</item>
        <item name="android:navigationBarColor">@color/bp_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Blipwave.Pill</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Blipwave.OutlinedButton</item>
        <item name="chipStyle">@style/Widget.Blipwave.Chip</item>
        <item name="toolbarStyle">@style/Widget.Blipwave.Toolbar</item>
    </style>

    <style name="Theme.Blipwave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Blipwave</item>
    </style>

    <!-- Şekiller -->
    <style name="ShapeAppearance.Blipwave.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Bileşen stilleri -->
    <style name="Widget.Blipwave.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/bp_outline</item>
        <item name="android:textColor">@color/bp_on_background</item>
        <item name="iconTint">@color/bp_on_background</item>
        <item name="android:textAppearance">@style/TextAppearance.Blipwave.Label</item>
    </style>

    <style name="Widget.Blipwave.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconTint">@color/bp_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Blipwave.Pill</item>
    </style>

    <style name="Widget.Blipwave.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Blipwave.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Blipwave.Caption</item>
        <item name="titleTextColor">@color/bp_on_background</item>
        <item name="subtitleTextColor">@color/bp_on_surface_variant</item>
    </style>

    <!-- Gradyan dolgulu ana eylem butonu (TextView tabanlı; MaterialButton arka planı ezmeye izin vermez) -->
    <style name="Widget.Blipwave.GradientButton" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@android:color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.Blipwave.Label</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/btn_brand</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">8dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/electric_violet</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/electric_violet</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Gradyan kart -->
    <style name="Widget.Blipwave.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/electric_violet</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/electric_violet</item>
    </style>

    <!-- Yazı stilleri -->
    <style name="TextAppearance.Blipwave.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/bp_on_background</item>
    </style>

    <style name="TextAppearance.Blipwave.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bp_on_background</item>
    </style>

    <style name="TextAppearance.Blipwave.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bp_on_background</item>
    </style>

    <style name="TextAppearance.Blipwave.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/bp_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Blipwave.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/bp_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Blipwave.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Blipwave.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/bp_on_surface_variant</item>
    </style>
</resources>
